+.fix-item-actions { display: flex; gap: 9px; margin-top: 13px; flex-wrap: wrap; }
+
+/* ── Live findings table ── */
+.verify-findings-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; margin-bottom: 14px; flex-wrap: wrap; }
+.verify-findings-sub { font-size: 13.5px; color: var(--text-secondary); margin: 0; }
+.verify-findings .tbl td, .verify-findings .tbl th { font-size: 13.5px; padding: 11px 14px; }
+.verify-findings .tbl tbody tr { transition: background .18s ease; }
+
+/* ── Measurement-detail drawer ── */
+.verify-tech { padding: 0; overflow: hidden; }
+.verify-tech summary {
+  list-style: none; cursor: pointer;
+  display: flex; align-items: center; gap: 12px;
+  padding: 16px 20px;
+  color: var(--text-secondary);
+  transition: background .2s ease;
+}
+.verify-tech summary::-webkit-details-marker { display: none; }
+.verify-tech summary:hover { background: var(--accent-lighter); }
+.verify-tech summary:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
+.verify-tech summary strong { display: block; font-size: 14.5px; color: var(--text-primary, #1c2033); }
+.verify-tech summary small { display: block; font-size: 12.5px; margin-top: 1px; }
+.verify-tech-body { padding: 4px 20px 18px; display: grid; gap: 14px; }
+.verify-tech-row { display: grid; grid-template-columns: 130px 1fr; gap: 12px; align-items: start; }
+.verify-tech-label { font-size: 11.5px; font-weight: 800; text-transform: uppercase; letter-spacing: .08em; color: var(--text-tertiary); padding-top: 4px; }
+.verify-tech-row p { margin: 0; font-size: 13.5px; line-height: 1.55; color: var(--text-secondary); }
+.verify-tech-row p.is-bad { color: var(--danger); }
+.verify-tech-chips { display: flex; flex-wrap: wrap; gap: 7px; }
+.verify-tech-chip {
+  font-size: 12.5px; font-weight: 700; padding: 5px 11px; border-radius: 999px;
+  background: rgba(0,0,0,.045); color: var(--text-secondary);
+}
+.verify-tech-chip.is-measured { background: var(--success-bg); color: #0b7c5c; }
+.verify-tech-chip.is-unavailable { background: rgba(0,0,0,.045); color: var(--text-tertiary); }
+.verify-tech-chip.is-not_applicable { background: var(--warning-bg); color: #9a6700; }
+@media (max-width: 640px) { .verify-tech-row { grid-template-columns: 1fr; gap: 4px; } }
+
+/* Workflow chooser descriptions — the text under the two flow buttons was
+   12px low-contrast grey, effectively invisible. Readable now. */
+.tree-branch-description {
+  font-size: 13.5px;
+  line-height: 1.6;
+  color: var(--text-secondary);
+  max-width: 300px;
+}
+.tree-branch-btn .branch-text { font-size: 15px; }

# ─── Server Configuration ────────────────────────────────────────────
PORT=3001

# ─── Authentication ──────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-secret

# Secret used to bind verification evidence to its submitted anchor images.
# Use a long, unique value outside local demos.
EVIDENCE_BINDING_SECRET=replace-with-a-long-random-secret

# ─── Local ML worker (ai_server.py — Layers 1 through 3.7) ──────────
# Start it separately:  python services/ai_server.py
#
# Use an explicit IPv4 loopback address. "localhost" resolves to ::1 first on
# many machines while uvicorn binds IPv4, which surfaces as "fetch failed" even
# with the worker running.
ANCHOR_ML_URL=http://127.0.0.1:8100
# Per-inference timeout, and the timeout for the /health probe.
ANCHOR_ML_TIMEOUT_MS=30000
ANCHOR_ML_HEALTH_TIMEOUT_MS=2000

# ─── Groq API (Primary LLM — Layer 5 text generation) ───────────────
# Get your key at: https://console.groq.com/keys
# Model used: llama-3.3-70b-versatile
GROQ_API_KEY=gsk_your_groq_api_key_here

# ─── Google Gemini API (Vision parsing + text fallback) ──────────────
# Get your key at: https://aistudio.google.com/apikey
# Models used: gemini-2.5-flash (vision), gemini-1.5-flash (text)
#
# Single key:
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
#
# OR multiple keys for rate-limit rotation (comma-separated):
# GEMINI_API_KEYS=AIzaSy_key1,AIzaSy_key2,AIzaSy_key3

# Set to true only when a production live catalog-generation worker is configured.
# Leave false to use the verified demo fixtures only.
ANCHOR_ENABLE_LIVE_GENERATION=false

# ─── Server Configuration ────────────────────────────────────────────
PORT=3001

# ─── Authentication ──────────────────────────────────────────────────
JWT_SECRET=anchor-demo-secret-key

# ─── Groq API (Primary LLM — Layer 5 text generation) ───────────────
# Get your key at: https://console.groq.com/keys
# Model used: llama-3.3-70b-versatile
GROQ_API_KEY=gsk_your_groq_api_key_here

# ─── Google Gemini API (Vision parsing + text fallback) ──────────────
# Get your key at: https://aistudio.google.com/apikey
# Models used: gemini-2.5-flash (vision), gemini-1.5-flash (text)
#
# Single key:
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
#
# OR multiple keys for rate-limit rotation (comma-separated):
# GEMINI_API_KEYS=AIzaSy_key1,AIzaSy_key2,AIzaSy_key3
